{
  "openapi": "3.0.1",
  "info": {
    "title": "cascade-api",
    "version": "1.0",
    "description": "HTTP API for the cascade frontend. Import in API Gateway > Create API > HTTP API > Import. Replace REPLACE_WITH_FRONTEND_ORIGIN first. See docs/infrastructure.md."
  },
  "x-amazon-apigateway-cors": {
    "allowOrigins": [
      "REPLACE_WITH_FRONTEND_ORIGIN"
    ],
    "allowMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "allowHeaders": [
      "content-type",
      "x-cascade-session",
      "authorization"
    ],
    "exposeHeaders": [
      "retry-after"
    ],
    "maxAge": 600,
    "allowCredentials": false
  },
  "paths": {
    "/jobs": {
      "post": {
        "summary": "Submit a question (lambdas/submit). Requires the x-cascade-session header or a JWT.",
        "responses": {
          "202": {
            "description": "Queued: {jobId, sessionId}"
          },
          "400": {
            "description": "Invalid body"
          },
          "401": {
            "description": "No owner identity"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Could not queue"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "payloadFormatVersion": "2.0",
          "timeoutInMillis": 29000,
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:ACCOUNT_ID:function:cascade-submit/invocations"
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "summary": "Job status (lambdas/status). Only the submitting owner can read it.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{jobId, status, answer?, toolCalls?, citations?, error?, durationMs?}"
          },
          "401": {
            "description": "No owner identity"
          },
          "404": {
            "description": "Not found or not yours"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "payloadFormatVersion": "2.0",
          "timeoutInMillis": 29000,
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:ACCOUNT_ID:function:cascade-status/invocations"
        }
      }
    },
    "/research": {
      "get": {
        "summary": "Research tables for one ticker (lambdas/research). Public, read-only.",
        "parameters": [
          {
            "name": "ticker",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Table envelope + meta"
          },
          "400": {
            "description": "Unsupported ticker"
          },
          "404": {
            "description": "Ticker missing from this run"
          },
          "502": {
            "description": "sensitivities unreadable"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "payloadFormatVersion": "2.0",
          "timeoutInMillis": 29000,
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:ACCOUNT_ID:function:cascade-research/invocations"
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Signed-in user's profile/portfolio and conversation list (lambdas/userdata)",
        "security": [
          {
            "cognito": []
          }
        ],
        "responses": {
          "200": {
            "description": "{username, workspace, chats:[{id,title,updatedAt}]}"
          },
          "401": {
            "description": "Missing or invalid Cognito ID token"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "payloadFormatVersion": "2.0",
          "timeoutInMillis": 10000,
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:339713040194:function:cascade-userdata/invocations"
        }
      },
      "put": {
        "summary": "Save profile and portfolio: body {workspace}",
        "security": [
          {
            "cognito": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ok, updatedAt}"
          },
          "413": {
            "description": "Body over 50 KB"
          },
          "401": {
            "description": "Missing or invalid Cognito ID token"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "payloadFormatVersion": "2.0",
          "timeoutInMillis": 10000,
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:339713040194:function:cascade-userdata/invocations"
        }
      },
      "delete": {
        "summary": "Delete every stored item of this user (account deletion)",
        "security": [
          {
            "cognito": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ok, deleted}"
          },
          "401": {
            "description": "Missing or invalid Cognito ID token"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "payloadFormatVersion": "2.0",
          "timeoutInMillis": 10000,
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:339713040194:function:cascade-userdata/invocations"
        }
      }
    },
    "/me/chats/{id}": {
      "get": {
        "summary": "One stored conversation",
        "security": [
          {
            "cognito": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The conversation"
          },
          "404": {
            "description": "Not found"
          },
          "401": {
            "description": "Missing or invalid Cognito ID token"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "payloadFormatVersion": "2.0",
          "timeoutInMillis": 10000,
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:339713040194:function:cascade-userdata/invocations"
        }
      },
      "put": {
        "summary": "Save a conversation: body {conversation}",
        "security": [
          {
            "cognito": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ok, updatedAt}"
          },
          "413": {
            "description": "Over 350 KB"
          },
          "401": {
            "description": "Missing or invalid Cognito ID token"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "payloadFormatVersion": "2.0",
          "timeoutInMillis": 10000,
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:339713040194:function:cascade-userdata/invocations"
        }
      },
      "delete": {
        "summary": "Delete a conversation",
        "security": [
          {
            "cognito": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ok}"
          },
          "401": {
            "description": "Missing or invalid Cognito ID token"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "payloadFormatVersion": "2.0",
          "timeoutInMillis": 10000,
          "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:339713040194:function:cascade-userdata/invocations"
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cognito": {
        "type": "oauth2",
        "flows": {},
        "x-amazon-apigateway-authorizer": {
          "type": "jwt",
          "identitySource": "$request.header.Authorization",
          "jwtConfiguration": {
            "issuer": "https://cognito-idp.us-east-1.amazonaws.com/REPLACE_WITH_USER_POOL_ID",
            "audience": [
              "REPLACE_WITH_APP_CLIENT_ID"
            ]
          }
        }
      }
    }
  }
}
