{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUpdateJob",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:339713040194:table/cascade-jobs"
    },
    {
      "Sid": "ConsumeQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:339713040194:agent-jobs"
    },
    {
      "Sid": "InvokeAgentRuntime",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:339713040194:runtime/agent-uciA60FqQs",
        "arn:aws:bedrock-agentcore:us-east-1:339713040194:runtime/agent-uciA60FqQs/*"
      ]
    },
    {
      "Sid": "WriteTraces",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::cascade-s3-bucket/traces/*"
    }
  ]
}
