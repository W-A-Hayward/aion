{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PutJobAndRateCounters",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:339713040194:table/cascade-jobs"
    },
    {
      "Sid": "EnqueueJob",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:339713040194:agent-jobs"
    }
  ]
}
